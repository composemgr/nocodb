# nocodb - app.env.sample
# Copy to app.env and adjust values before starting the stack.

# Timezone
TZ=America/New_York

# Hostname / domain
BASE_HOST_NAME=${HOSTNAME}
BASE_DOMAIN_NAME=example.com

# Admin credentials
APP_ADMIN_USER=administrator
APP_ADMIN_PASS=changeme_admin_password

# JWT secret key (min 32 chars)
APP_SECRET_KEY=changeme_secret_key_min_32_chars

# Database credentials
DB_USER_NAME=nocodb
DB_USER_PASS=changeme_db_password
DB_CREATE_DATABASE_NAME=nocodb

# Email / SMTP settings
EMAIL_SERVER_HOST=172.17.0.1
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASS=
EMAIL_SERVER_MAIL_FROM=no-reply@example.com
