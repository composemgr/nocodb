# app.env.sample
# Copy to app.env and adjust values before starting the stack.
# These variables override the matching values in default.env for this app.
# No `export` prefix - this file is read by `docker compose --env-file`.

TZ=America/New_York
BASE_DOMAIN_NAME=example.com
BASE_HOST_NAME=nocodb.example.com

APP_ORG_NAME=NocoDB
APP_RUN_AS=1000:1000

# Admin account, only used when the database is empty.
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASS=replace-with-a-random-password

# Database credentials
DB_USER_NAME=nocodb
DB_USER_PASS=replace-with-a-random-password

DB_CREATE_DATABASE_NAME=nocodb

# Auth secret for JWT tokens. Change it after first start.
APP_SECRET_KEY=replace-with-a-random-hex-string

# Email settings (configure for actual notifications)
EMAIL_SERVER_MAIL_FROM=no-reply@example.com
EMAIL_SERVER_HOST=172.17.0.1
EMAIL_SERVER_PORT=587
